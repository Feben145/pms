# Copy to .env and adjust per environment. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set USE_SQLITE=True only for quick local scripting without Docker/Postgres.
USE_SQLITE=False
POSTGRES_DB=pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed frontend's URL here once you have one.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
